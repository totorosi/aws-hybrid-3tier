# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 등록되어 있다. 커밋하지 않는다.

# ── 계정 · 리전 ────────────────────────────────────────────
AWS_ACCOUNT_ID=000000000000
REGION=sa-east-1
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com

# ── 네트워크 (EKS 가 재사용할 기존 VPC) ────────────────────
VPC_ID=vpc-xxxxxxxxxxxxxxxxx

AZ_A=sa-east-1a
AZ_B=sa-east-1b
AZ_C=sa-east-1c

# ALB 가 생성될 자리. kubernetes.io/role/elb=1 태그가 필요하다.
SUBNET_PUBLIC_A=subnet-xxxxxxxxxxxxxxxxx
SUBNET_PUBLIC_B=subnet-xxxxxxxxxxxxxxxxx
SUBNET_PUBLIC_C=subnet-xxxxxxxxxxxxxxxxx

# 워커노드가 들어갈 자리. kubernetes.io/role/internal-elb=1 태그가 필요하다.
SUBNET_EKS_A=subnet-xxxxxxxxxxxxxxxxx
SUBNET_EKS_B=subnet-xxxxxxxxxxxxxxxxx
SUBNET_EKS_C=subnet-xxxxxxxxxxxxxxxxx

# ── 인증서 ─────────────────────────────────────────────────
ACM_CERTIFICATE_ARN=arn:aws:acm:sa-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000

# ── EC2 계층: 컨테이너 MySQL (docker compose 가 직접 읽는다) ──
MYSQL_DATABASE=testdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ── EKS 계층: RDS Proxy ────────────────────────────────────
# 파드의 DB 자격증명은 여기에 두지 않는다.
# External Secrets Operator 가 Secrets Manager 에서 읽어
# 쿠버네티스 Secret 으로 동기화한다 (q11/k8s/02-external-secret.yaml).
RDS_PROXY_ENDPOINT=std15-test-db-proxy.proxy-xxxxxxxxxxxx.sa-east-1.rds.amazonaws.com
